# npm 11 warns about dependency install scripts. npm 12 will skip any script
# that is not listed in package.json allowScripts. strict-allow-scripts makes
# an unreviewed script fail the install instead of running. Entries set to
# false are skipped. Do not set ignore-scripts=false as a workaround, and do
# not pass --dangerously-allow-all-scripts.
strict-allow-scripts=true
